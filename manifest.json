{
  "manifest_version": 3,
  "name": "GitHub_Frame",
  "version": "1.0",
  "description": "GitHub 잔디에 테두리를 추가하는 확장 프로그램",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/FrameLogo.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "128": "icons/FrameLogo.png"
  }
}